    fun addStock(productId: String, quantity: Int) {
        val index = products.indexOfFirst { it.id == productId }
        if (index >= 0) {
            val product = products[index]
            products[index] = product.copy(stock = product.stock + quantity)
        }
    }

    fun reduceStock(productId: String, quantity: Int) {
        val index = products.indexOfFirst { it.id == productId }
        if (index >= 0) {
            val product = products[index]
            products[index] = product.copy(stock = maxOf(0, product.stock - quantity))
        }
    }
}
